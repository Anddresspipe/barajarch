    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "tsarch": "^5.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
